{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "g++ -std=c++17 -g -I ${workspaceFolder}/${input:project}/include $(find ${workspaceFolder}/${input:project} -name '*.cpp') -o ${workspaceFolder}/${input:project}/output",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "run",
      "type": "shell",
      "command": "${workspaceFolder}/${input:project}/output",
      "dependsOn": "build",
      "group": { "kind": "test", "isDefault": true }
    }
  ],
  "inputs": [
    {
      "id": "project",
      "type": "pickString",
      "description": "Select project to build",
      "options": ["linked-lists", "geometric_vectors"]
    }
  ]
}